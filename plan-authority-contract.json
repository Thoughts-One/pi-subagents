{
  "schema_version": 1,
  "claude_prefix": "Claude-Subagent-Receipt: ",
  "fallback_prefix": "Plan-Fallback-Receipt: ",
  "claude_receipt_keys": [
    "role",
    "model",
    "outcome",
    "input_tokens",
    "output_tokens",
    "cache_read_tokens",
    "cache_write_tokens",
    "duration_ms",
    "failure_class",
    "escalated",
    "truncated"
  ],
  "fallback_receipt_keys": [
    "role",
    "authority_model",
    "authority_outcome",
    "failure_class",
    "author_model"
  ],
  "fallback_receipt_template": {
    "role": "planner",
    "authority_model": "claude-fable-5",
    "authority_outcome": "failure",
    "failure_class": "<returned allowed failure class>",
    "author_model": "openai-codex/gpt-5.6-sol"
  },
  "failure_classes": [
    "aborted",
    "aggregate",
    "claude-error",
    "environment",
    "executable",
    "internal",
    "malformed-json",
    "model-usage",
    "output-limit",
    "process",
    "schema-or-input",
    "spawn",
    "structured-output",
    "timeout",
    "unexpected-model"
  ],
  "outcome_exempt_roles": ["Plan", "trial"]
}
